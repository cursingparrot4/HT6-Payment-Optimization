# Runtime behavior
PAYMENT_ENGINE_ENV=development
PAYMENT_ENGINE_API_URL=http://127.0.0.1:8000
INTENT_PROVIDER=fixture
ALLOW_PROMPTED_FALLBACK=false

# Freesolo adapter (unavailable at scaffold time)
